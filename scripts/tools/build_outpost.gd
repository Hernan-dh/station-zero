extends "res://scripts/tools/outpost_kit.gd"
## Bake the reusable outpost models. Run with:
## godot --headless --path . --script res://scripts/tools/build_outpost.gd
## Runtime loads the saved scenes; no procedural construction is needed in game.
## The airlock and perimeter variants are generated by build_habitat_entrances.gd.

func _initialize() -> void:
	build_banner()
	build_wall()
	build_annex()
	build_beacon()
	build_site()
	print("Baked concept 3 outpost models")
	quit()
